<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="사칙연산 계산기" android:textSize="32sp" android:textStyle="bold" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="두 숫자를 입력하고 연산을 눌러주세요. 소수와 음수도 입력할 수 있어요." android:textSize="16sp" />
<EditText android:id="@+id/firstNumber" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:minHeight="56dp" android:hint="첫 번째 숫자" android:inputType="numberDecimal|numberSigned" android:singleLine="true" />
<EditText android:id="@+id/secondNumber" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:minHeight="56dp" android:hint="두 번째 숫자" android:inputType="numberDecimal|numberSigned" android:singleLine="true" />
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:orientation="horizontal">
<Button android:id="@+id/addButton" android:layout_width="0dp" android:layout_height="64dp" android:layout_weight="1" android:text="+" android:contentDescription="덧셈" android:textSize="26sp" />
<Button android:id="@+id/subtractButton" android:layout_width="0dp" android:layout_height="64dp" android:layout_weight="1" android:text="−" android:contentDescription="뺄셈" android:textSize="26sp" />
<Button android:id="@+id/multiplyButton" android:layout_width="0dp" android:layout_height="64dp" android:layout_weight="1" android:text="×" android:contentDescription="곱셈" android:textSize="26sp" />
<Button android:id="@+id/divideButton" android:layout_width="0dp" android:layout_height="64dp" android:layout_weight="1" android:text="÷" android:contentDescription="나눗셈" android:textSize="26sp" />
</LinearLayout>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:text="계산 결과" android:textSize="18sp" />
<TextView android:id="@+id/resultText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="결과가 여기에 표시됩니다" android:textSize="28sp" android:textStyle="bold" android:textIsSelectable="true" android:accessibilityLiveRegion="polite" />
</LinearLayout>
</ScrollView>
